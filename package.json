{
  "name": "apploom",
  "version": "1.0.0",
  "description": "Descargador de videos de Loom",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "keywords": [],
  "author": "Hanks3",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.hanks3.apploom",
    "productName": "Loom Downloader",
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      "yt-dlp.exe",
      "ffmpeg.exe",
      "ffprobe.exe",
      "cookies.txt",
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1"
  }
}